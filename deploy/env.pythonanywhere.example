# =============================================================================
# FACCI Care — Plantilla de .env para PythonAnywhere
# =============================================================================
# Copiala al proyecto y complétala con tus valores reales:
#
#   cp deploy/env.pythonanywhere.example ~/faccicare/.env
#   nano ~/faccicare/.env
#
# El archivo .env NO se versiona (esta en .gitignore): vive solo en el servidor.
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIA-ESTA-CLAVE-POR-UNA-GENERADA
DJANGO_ALLOWED_HOSTS=tuusuario.pythonanywhere.com
# Opcional: por defecto se derivan de ALLOWED_HOSTS con https://
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com

# ── Base de datos MySQL de PythonAnywhere ─────────────────────────────────────
# Los datos exactos estan en la pestana "Databases" del panel.
DB_ENGINE=django.db.backends.mysql
DB_NAME=tuusuario$faccicare
DB_USER=tuusuario
DB_PASSWORD=tu-password-de-mysql
DB_HOST=tuusuario.mysql.pythonanywhere-services.com
DB_PORT=3306

# ── Cifrado de datos sensibles ────────────────────────────────────────────────
# Genera la clave UNA sola vez y no la cambies: los datos ya cifrados
# dejarian de poder descifrarse.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACCI_ENCRYPTION_KEY=CAMBIA-ESTA-CLAVE-FERNET

# ── Correo ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@faccicare.org
